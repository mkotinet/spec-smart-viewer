{
  "version": 2,
  "name": "spec-nrdk2",
  "framework": null,
  "buildCommand": "echo 'Vercel Reverse Proxy Gateway Ready'",
  "outputDirectory": "frontend",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/manifest.json",
      "destination": "/static/manifest.json"
    },
    {
      "source": "/sw.js",
      "destination": "/static/sw.js"
    },
    {
      "source": "/api/:path*",
      "destination": "https://spec.danminlove.com/api/:path*"
    }
  ]
}
